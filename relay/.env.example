# Copy to relay/.env (gitignored) and fill in the keys you have. Never commit .env.
# Profiles (adapter, base_url, model, options) live in relay/providers.toml;
# each profile names the env var below that holds its key.

# Default profile for clients that haven't switched (see providers.toml).
ACTIVE_PROFILE=claude

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Qwen / Model Studio: the key is bound to its region (see providers.toml)
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# (Ollama needs no key)

# Relay TCP port. Keep equal to RELAY_PORT in net/ap.conf (firewall).
PORT=4242

# Optional limits (defaults shown)
# MAX_TOKENS=2048     # per reply, reasoning included; a profile can override
# MAX_MSG=1024        # max bytes of one user message from the DS
# MAX_TURNS=40        # exchanges kept per client before RSET is required
# MAX_SEND_PER_MIN=10 # messages per client per minute (protects your API quota), 0 = off

# Keep this file private: chmod 600 relay/.env (the relay warns otherwise).

# Voice input (hold Y on the DS). Needs the optional speech-to-text engine:
# relay/voice/setup.sh (asks before downloading; ~768 MB with both models).
# VOICE=auto          # auto = on if installed; off = never offer it
# VOICE_MODEL=small   # small (better, ~2 s per phrase) or base (faster, less accurate)
# Names and words you use often, given to Whisper as a hint (one line):
# VOICE_HINTS=Ada Lovelace, Grace Hopper, Reykjavik
